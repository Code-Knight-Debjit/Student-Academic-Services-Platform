[Unit]
Description=Student Results System Gunicorn Daemon
Requires=student_results.socket
After=network.target

[Service]
User=debjit
Group=www-data
WorkingDirectory=home/debjit/Desktop/SASP
Environment="PATH=/home/debjit/Desktop/SASP/.venv/bin"
ExecStart=/home/debjit/Desktop/SASP/.venv/bin/gunicorn \
          --workers 3 \
          --bind unix:run/student_results.sock \
          --timeout 30 \
          student_results.wsgi.application

[Install]
WantedBy=multi-user.target